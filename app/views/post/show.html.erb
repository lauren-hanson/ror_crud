<%= link_to "See All Posts", post_index_path %>

<%# Decide the color based on location %>
<% color = case @post.location
   when "Nashville" then "green"
   when "Memphis" then "blue"
   when "Knoxville" then "orange"
   when "Chattanooga" then "purple"
   else "gray"
end %>

<h1>
  <%# Colored square %>
  <span style="display:inline-block; width:20px; height:20px; background-color:<%= color %>; margin-right:4px; border-radius:50%; "></span>
  <%= @post.title %>
</h1>

<p> <%=@post.description %> </p>


<%= link_to "Edit", post_edit_path(@post) %><br>
<%= link_to "Delete", post_delete_path(@post), data: {
    turbo_method: :delete,
    turbo_confirm: "Are you sure?"
} %>